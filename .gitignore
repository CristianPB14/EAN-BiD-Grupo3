# --- Credenciales y variables de entorno reales (nunca se versionan) ---
.env
.env.*
!.env.example

# --- Configuración de servicios SIN secretos (sí se versiona) ---
# hadoop.env solo declara nombre de clúster, rutas de HDFS/YARN y replicación:
# no tiene contraseñas. Debe quedar excluido del bloqueo de *.env de arriba.
!hadoop.env

# --- Entornos virtuales de Python ---
venv/
env/

# --- Datos pesados y muestras locales (nunca se versionan, la estructura sí) ---
data/raw/*
!data/raw/.gitkeep
**/data/raw/*
!**/data/raw/.gitkeep
muestra/*.csv
*.parquet

# --- Basura del sistema operativo y editores ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Caché de Python ---
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
datos_lago/
