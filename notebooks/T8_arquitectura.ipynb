import pandas as pd
import os
import time

# Lectura del CSV
inicio = time.perf_counter()

df = pd.read_csv("data/raw/datos.csv")

tiempo_csv = time.perf_counter() - inicio

# Escritura Parquet
inicio = time.perf_counter()

df.to_parquet(
    "data/raw/datos.parquet",
    index=False
)

tiempo_parquet = time.perf_counter() - inicio

csv_size = os.path.getsize("data/raw/datos.csv")
parquet_size = os.path.getsize("data/raw/datos.parquet")

comparacion = pd.DataFrame({
    "Formato": ["CSV", "Parquet"],
    "Tamaño_MB": [
        csv_size / (1024**2),
        parquet_size / (1024**2)
    ],
    "Tiempo_escritura_s": [
        tiempo_csv,
        tiempo_parquet
    ]
})

comparacion

